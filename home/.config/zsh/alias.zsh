#!/bin/zsh

alias please="sudo"
alias pls="sudo"

# shortcuts
alias m="make"
alias g="lazygit"
alias n="nvim"
alias d="lazydocker"
alias z="zoxide"
alias neofetch="fastfetch"

# replace common tools
# exa is unmaintained; eza is the maintained fork and what nixpkgs ships.
alias l="eza -lah"
alias la="eza -lah"
alias exa="eza -lah"
alias rm="trash"
alias mr="trash-restore"

# python
alias python=python3
alias py=python
alias py3=python3
